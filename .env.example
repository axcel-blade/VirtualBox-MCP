# Path to a JSON configuration file (optional)
VBOX_MCP_CONFIG=./virtualbox-mcp.config.json
# Override VBoxManage location (default: auto-detect)
VBOX_MCP_VBOXMANAGE_PATH=
# Transport selection
VBOX_MCP_STDIO=true
VBOX_MCP_HTTP=false
VBOX_MCP_HTTP_PORT=3000
VBOX_MCP_HTTP_HOST=127.0.0.1
# Required when HTTP transport is enabled. Generate with: openssl rand -hex 32
VBOX_MCP_HTTP_TOKEN=
# Master key for the encrypted credential store (32+ characters). Never commit a real value.
VBOX_MCP_MASTER_KEY=
# State directory (approvals, credential store, audit log)
VBOX_MCP_STATE_DIR=
VBOX_MCP_LOG_LEVEL=info
